<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The updated memory safety rules of C# 15: only operations that access native memory need an unsafe context, and a member marked unsafe passes that need on to its callers. -->
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>CA2225;CA1031</NoWarn>
    <!-- A banned call (BannedSymbols.txt) does not compile, also in a local build without /warnaserror. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>

    <Description>A .NET wrapper around Luau focused on native AOT compatibility, typed value access, and explicit ownership.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Darp.Luau.Native" Version="0.11.0" />
    <!-- Enforces BannedSymbols.txt: the calls that only Internal/LuauVm.cs may make. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Darp.Luau.Generator\Darp.Luau.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
    <None
      Include="..\Darp.Luau.Generator\bin\$(Configuration)\netstandard2.0\Darp.Luau.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
