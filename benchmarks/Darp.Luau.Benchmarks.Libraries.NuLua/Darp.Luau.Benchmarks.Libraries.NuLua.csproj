<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="NuLua" Version="0.1.0" />
    <PackageReference Include="NuLua.Luau" Version="0.1.0" />
  </ItemGroup>

  <!-- Records the version of every referenced package in the assembly, where the chart reads it from. -->
  <ItemGroup>
    <AssemblyMetadata Include="@(PackageReference->'PackageVersion:%(Identity)')" Value="%(Version)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Darp.Luau.Benchmarks.Libraries\Scenario.cs" Link="Scenario.cs" />
  </ItemGroup>
</Project>
